<Window x:Class="MallClient.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="640" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="RegisterWindow_OnClosing">

    <Grid Margin="24">
        <Border Background="{StaticResource CardBrush}"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F1F5F9"
                        CornerRadius="16,16,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,12,10,12">
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="14"
                                Cursor="Hand"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="40,20,40,32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="Создание аккаунта" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Заполните данные для регистрации" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ФИО" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,0,0,14"/>

                            <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Style="{StaticResource ModernPasswordBox}"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding Error}"
                                       Style="{StaticResource ErrorText}"
                                       Margin="0,0,0,12"
                                       Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"/>

                            <Button Content="Зарегистрироваться"
                                    Command="{Binding RegisterCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="44"
                                    FontSize="14"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Content="Назад ко входу"
                            Command="{Binding GoToLoginCommand}"
                            Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>