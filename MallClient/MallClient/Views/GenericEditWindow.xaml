<Window x:Class="MallClient.Views.GenericEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="620" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="24">
        <Border Background="{StaticResource CardBrush}" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border Grid.Row="0" 
                        Background="#F1F5F9" 
                        CornerRadius="16,16,0,0" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,32,0"/>

                        <Button Grid.Column="1" 
                                Content="✕"
                                Width="32" Height="32"
                                Background="#E2E8F0"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="14"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#CBD5E1"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Content -->
                <Border Grid.Row="1" Background="White" Margin="24,16,24,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource LabelText}"/>

                                        <!-- Обычное текстовое поле -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                 MaxLength="{Binding MaxLength}" 
                                                 FocusVisualStyle="{x:Null}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDropdown}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNumeric}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDate}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEmail}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Числовое поле -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                 MaxLength="{Binding MaxLength}"
                                                 PreviewTextInput="NumericTextBox_PreviewTextInput"
                                                 DataObject.Pasting="NumericTextBox_Pasting"
                                                 FocusVisualStyle="{x:Null}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNumeric}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Поле телефона -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                 MaxLength="{Binding MaxLength}"
                                                 PreviewTextInput="PhoneTextBox_PreviewTextInput"
                                                 FocusVisualStyle="{x:Null}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPhone}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Поле Email -->
                                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                 MaxLength="{Binding MaxLength}"
                                                 FocusVisualStyle="{x:Null}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEmail}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>

                                        <!-- Поле даты -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDate}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <DatePicker SelectedDate="{Binding DateValue, UpdateSourceTrigger=PropertyChanged}" 
                                                        Height="40" 
                                                        VerticalContentAlignment="Center" 
                                                        FocusVisualStyle="{x:Null}" 
                                                        BorderThickness="1" 
                                                        BorderBrush="{StaticResource BorderBrush}">
                                                <DatePicker.Resources>
                                                    <Style TargetType="DatePickerTextBox">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="DatePickerTextBox">
                                                                    <Grid>
                                                                        <Border Background="Transparent" CornerRadius="8"/>
                                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                    </Grid>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </DatePicker.Resources>
                                            </DatePicker>
                                        </Grid>

                                        <!-- Выпадающий список -->
                                        <ComboBox ItemsSource="{Binding Options}" 
                                                  SelectedValuePath="Value" 
                                                  SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                  FocusVisualStyle="{x:Null}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDropdown}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="24,16,24,24">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Style="{StaticResource ErrorText}" 
                               Margin="0,0,0,12" 
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <Button Content="Сохранить" 
                            Command="{Binding SaveCommand}" 
                            IsEnabled="{Binding CanSave}" 
                            Style="{StaticResource PrimaryButton}" 
                            Height="44" 
                            FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>