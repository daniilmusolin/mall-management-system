<Window x:Class="MallClient.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="LoginWindow_OnClosing">

    <Grid Margin="24">
        <Border Background="{StaticResource CardBrush}"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#0F172A"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#F1F5F9"
                        CornerRadius="16,16,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,12,10,12">
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Width="32" Height="32"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="14"
                                Cursor="Hand"
                                Click="CloseButton_Click"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="40,20,40,40">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="Войти в аккаунт" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Управление торговым центром" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,32"/>

                        <TextBlock Text="Email" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="254"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Пароль" Style="{StaticResource LabelText}"/>
                        <PasswordBox x:Name="PasswordBox"
                                     MaxLength="72"
                                     Style="{StaticResource ModernPasswordBox}"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                     Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding Error}"
                                   Style="{StaticResource ErrorText}"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <Button Content="Войти"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="44"
                                FontSize="14"
                                Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock Text="Нет аккаунта?" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <Button Content="Создать"
                                Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource GhostButton}"
                                Padding="8,4"
                                FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>