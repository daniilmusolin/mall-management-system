<Window x:Class="MallClient.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="260" 
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid Margin="20">
        <Border Background="{StaticResource CardBrush}" 
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" 
                                  ShadowDepth="4" 
                                  Opacity="0.18" 
                                  Color="#0F172A"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0" 
                        Background="#F1F5F9" 
                        CornerRadius="16,16,0,0" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="24,12,16,12">
                        <TextBlock Text="Подтверждение" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Контент -->
                <StackPanel Grid.Row="1" 
                            Margin="24,20,24,20" 
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" 
                                Margin="0,0,0,12">
                        <Path Data="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M13,15H11V17H13V15M13,7H11V13H13V7Z" 
                              Fill="{StaticResource DangerBrush}" 
                              Width="24" 
                              Height="24" 
                              Stretch="Uniform" 
                              Margin="0,0,12,0"/>
                        <TextBlock Text="Внимание" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="MessageText" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               TextWrapping="Wrap" 
                               LineHeight="20"/>
                </StackPanel>

                <!-- Кнопки -->
                <Border Grid.Row="2" 
                        Background="#F8FAFC" 
                        CornerRadius="0,0,16,16" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="0,1,0,0" 
                        Padding="24,12">
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <Button Content="Отмена" 
                                Width="100" 
                                Height="36" 
                                Margin="0,0,12,0" 
                                Style="{StaticResource GhostButton}" 
                                Click="Cancel_Click"/>
                        <Button Content="Удалить" 
                                Width="100" 
                                Height="36" 
                                Style="{StaticResource DangerButton}" 
                                Click="Confirm_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>